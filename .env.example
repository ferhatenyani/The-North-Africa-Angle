# WhatsApp number shown in the floating button and wa.me links (digits, with country code).
# PENDING from client — see PLAN.md §7.
NEXT_PUBLIC_WHATSAPP_NUMBER=+213XXXXXXXXX

# Web3Forms access key (create free at https://web3forms.com with the client's professional mailbox).
# Without a key the contact form shows a friendly configuration error instead of submitting.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site URL, used in metadata once the domain is live.
NEXT_PUBLIC_SITE_URL=https://thenorthafricangle.com
